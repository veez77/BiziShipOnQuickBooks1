# Copy to .env and fill in. NEVER commit .env.

# Intuit app keys (Developer portal -> your app -> Keys and credentials -> Development)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI registered in the Intuit app settings
QBO_REDIRECT_URI=http://localhost:3000/callback

PORT=3000
HOST=127.0.0.1

# shared-secret (default, what the web app uses): requests carry X-ERP-Hub-Key + X-BiziShip-* headers.
# dev: a fixed company with the ADMIN role and no key. Local experiments only; never deploy it.
AUTH_MODE=shared-secret
# 1 or 2 comma-separated secrets, each at least 32 characters (2 during rotation).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HUB_API_KEYS=
DEV_BIZISHIP_COMPANY_ID=dev-company

# Where the browser lands after the QuickBooks consent (success AND failure; the Hub appends
# ?connected=... or ?error=...&message=... plus returnTo). The web app's settings page URL.
# FRONTEND_RETURN_URL=http://localhost:3000/settings/erp

# file = local development (encrypted JSON files in DATA_DIR). The deployed Lambda sets STORE=dynamodb itself.
STORE=file

# Base URL of the BiziShip web app; shipment links written into the ERP are built from it.
APP_BASE_URL=https://app.biziship.ai

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
STATE_SIGNING_KEY=
