# Copy to deploy.env (git-ignored) and fill in. Read by deploy-erp-hub-lambda.bat. No secrets belong here.

# Where the browser lands after the QuickBooks consent: the web app's QuickBooks settings page.
FRONTEND_RETURN_URL=https://app.biziship.ai/settings/erp

# The web app's base URL. Shipment links written into QuickBooks are built from it.
APP_BASE_URL=https://app.biziship.ai

# Who receives the CloudWatch alarm emails (AWS sends a confirmation you must click).
ALERT_EMAIL=
