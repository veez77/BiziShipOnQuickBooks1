{
  "name": "biziship-erp-hub",
  "version": "0.1.0",
  "private": true,
  "description": "BiziShip ERP Hub — provider-neutral integration service (QuickBooks Online first, Sage later)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:check": "serverless package --stage staging",
    "predeploy": "node -e \"require('fs').rmSync('.esbuild',{recursive:true,force:true})\"",
    "deploy": "serverless deploy --stage staging",
    "predeploy:prod": "npm run predeploy",
    "deploy:prod": "serverless deploy --stage prod",
    "secrets": "node scripts/put-secrets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1170.0",
    "@aws-sdk/client-kms": "^3.1170.0",
    "@aws-sdk/client-secrets-manager": "^3.1170.0",
    "@aws-sdk/lib-dynamodb": "^3.1170.0",
    "@fastify/aws-lambda": "^6.4.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
